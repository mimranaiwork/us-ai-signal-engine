# Copy to .env and adjust if needed. Defaults match docker-compose.yml.
POSTGRES_DB=us_ai_signal_engine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

# SEC EDGAR requires a traceable contact on every request (their fair-access
# policy) — "Your Name your-email@example.com". No API key/registration needed.
SEC_EDGAR_USER_AGENT=
